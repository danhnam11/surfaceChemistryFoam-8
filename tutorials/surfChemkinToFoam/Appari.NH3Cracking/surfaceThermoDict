FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      surfaceThermoDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

surfaceThermoDefaults
{
    // equationOfState
    rho     8900;     // kg/m3

    // transport
    mu      0;        // kg/m/s
    Pr      1;

    // thermodynamics, used only when surfaceThermoModel == const
    Cp      440;      // J/kg/K
    Cv      440;      // J/kg/K
    Hf      0;        // J/kg
}

