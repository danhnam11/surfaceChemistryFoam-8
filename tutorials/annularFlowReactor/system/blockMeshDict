FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 0.001;  //mm

halfAngle 2.5; 

// Radius 
r1 2.35; //inner radius of tube 
r2 4.5; //outer radius of tube 
x1 15;
x2 20;
x3 39; 

xNum #calc "20*$x1";
zNum1 #calc "4*$x1";
zNum2 #calc "4*($x2-$x1)";
zNum3 #calc "10*($x3-$x2)";

radHalfAngle    #calc "degToRad($halfAngle)";   //change degree to radian

y1   #calc "$r1*cos($radHalfAngle)";
z1   #calc "$r1*sin($radHalfAngle)";
nz1  #calc "-1*$z1";

y2   #calc "$r2*cos($radHalfAngle)";
z2   #calc "$r2*sin($radHalfAngle)";
nz2  #calc "-1*$z2";


vertices
(
  (0   $y1 $z1)      //0
  (0   $y1 $nz1)     //1
  ($x1 $y1 $z1)      //2
  ($x1 $y1 $nz1)     //3

  (0   $y2 $z2)      //4
  (0   $y2 $nz2)     //5
  ($x1 $y2 $z2)      //6
  ($x1 $y2 $nz2)     //7

);

blocks
(
    hex (0  2  3  1  4  6  7  5)   ($xNum 1 50)  simpleGrading (1 1 10) //block1
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (1 0 4 5)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (7 6 2 3)
        );
    }
    innerWall
    {
        type patch;
        faces
        (
            (0 1 3 2)
        );
    }
 
    outerWall
    {
        type patch;
        faces
        (
            (5 4 6 7)
        );
    }

    back
    {
        type symmetry;
        faces
        (
            (1 5 7 3)
        );
    }

    front
    {
        type symmetry;
        faces
        (
            (4 0 2 6)
        );
    }

);

mergePatchPairs
(
);

