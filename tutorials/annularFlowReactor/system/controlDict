FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     catalystFoam;

//startFrom       startTime;
startFrom       latestTime;

startTime       0;

stopAt          endTime;
//stopAt          writeNow;

endTime         0.2;

deltaT          1e-6;

writeControl    adjustableRunTime;

writeInterval   0.1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;
//adjustTimeStep  no;

maxCo           0.5;

functions
{
    moleFractions1
    {
        // Conditional mandatory entries (unmodifiable)
        // Either of the below depending on
        // the thermodynamics package used in the solver.

        // Option-1
        type                 psiReactionThermoMoleFractions;

        // Option-2
        //type                 rhoReactionThermoMoleFractions;

        // Mandatory entries (unmodifiable)
        libs                   ("libfieldFunctionObjects.so");

        // Optional entries (runtime modifiable)
        //phase                <phaseName>;

        // Optional (inherited) entries
        writeControl    writeTime;
        writeFields     true;
        log             true;
    }

    outletXO2
    {
        // Mandatory entries (unmodifiable)
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");

        // Mandatory entries (runtime modifiable)
        fields          (X_O2);
        operation       areaAverage;
        regionType      patch;
        name            outlet;

        // Optional (inherited) entries
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
    }

    outletXN2
    {
        // Mandatory entries (unmodifiable)
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");

        // Mandatory entries (runtime modifiable)
        fields          (X_N2);
        operation       areaAverage;
        regionType      patch;
        name            outlet;

        // Optional (inherited) entries
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
    }


    outletU
    {
        // Mandatory entries (unmodifiable)
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");

        // Mandatory entries (runtime modifiable)
        fields          (U);
        operation       areaAverage;
        regionType      patch;
        name            outlet;

        // Optional (inherited) entries
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
    }

}
