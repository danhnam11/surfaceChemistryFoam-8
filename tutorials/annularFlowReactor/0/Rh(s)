FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Rh(s).catalyst;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{    
    outerWall
    {
        type            zeroGradient;
    }
    innerWall
    {
        type            catalyticWall;
        value           uniform 1.0;
    }

    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }

    front
    {   
        type            symmetry;
    }

    back
    {
        type            symmetry;
    }
}

