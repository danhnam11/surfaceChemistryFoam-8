FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 890;


boundaryField
{
    outerWall
    {
        type            zeroGradient;
    }

    innerWall
    {   
        //type            zeroGradient;
        type            heatFluxFromCatalyticSurfaces;
        gradient        uniform 0.0;
        value           $internalField;
    }

    inlet
    {
        type            fixedValue;
        value           uniform 890;
    }
    outlet
    {
        type            zeroGradient;
    }

    front
    {
        type            symmetry;
    }

    back
    {
        type            symmetry;
    }
}

