FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);
 
boundaryField
{
    outerWall
    {
        type            noSlip;
    }

    innerWall
    {
        //type            noSlip;
        type            stefanFlowVelocity;
        refValue        uniform 0; //dummy value, doesnt affect to BCs
    }

    inlet
    {
        type                flowRateInletVelocity;
        massFlowRate        constant 7.23611E-08;
        value               uniform (0 0 0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           $internalField;
    }
    
    front
    {   
        type            symmetry;
    }
    
    back
    {   
        type            symmetry;
    }
}

