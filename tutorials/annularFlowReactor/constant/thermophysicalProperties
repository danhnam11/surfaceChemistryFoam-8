FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

usingDetailedTransportModel false;  //default is false
usingCoTHERM                false; //default is false
soretEffect                 false;  //default is false

// Set major species list for coTHERM
// If coTHERM is not used, inertSpecies is used to form this list
// majorSpeciesForCoTHERM (CH4 H2 O2 N2 CO CO2 H2O);
majorSpeciesForCoTHERM (H2 NH3 N2);

// Set threshold for coThermPhy
epsilonOnlyT      0.1;    // [K]
epsilonT          0.1;    // [K]
epsilonP          100;    // [Pa]
epsilonSpecies    0.001;  // [-] mass fraction

thermoType
{
    type            hePsiThermo;
    mixture         multiComponentMixture;
    transport       sutherland;
    thermo          janaf;
    energy          sensibleEnthalpy;
    equationOfState perfectGas;
    specie          specie;
}

inertSpecie AR;

#include "thermo.STM"

