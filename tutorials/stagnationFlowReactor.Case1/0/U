FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);
 
boundaryField
{
    heatedWall
    {
        //type            noSlip;
        type            stefanFlowVelocity;
        refValue        uniform 0; // dummy value, doesnt affect to BCs
    }
    inlet
    {
        type            fixedValue;
        value           uniform (0.51 0 0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           $internalField;
    }

    axis
    {   
        type            empty;
    }
    
    front
    {   
        type            wedge;
    }
    
    back
    {   
        type            wedge;
    }
}

