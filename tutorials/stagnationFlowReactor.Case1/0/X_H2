FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      X_H2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.0573;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0.0573;
    }
    outlet
    {
        type            calculated;
        value           uniform 0.0573;
    }
    heatedWall
    {
        type            calculated;
        value           uniform 0.0573;
    }
    axis
    {
        type            empty;
    }
    back
    {
        type            wedge;
    }
    front
    {
        type            wedge;
    }
}


